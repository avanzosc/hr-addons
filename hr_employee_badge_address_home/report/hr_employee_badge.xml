<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template id="print_employee_badge_inherit" inherit_id="hr.print_employee_badge">
    <xpath expr="//div[@t-field='employee.barcode']" position="after">
      <div align="center" style="font-size:9pt; margin-top:2pt;">
        <t t-if="employee.work_contact_id and employee.work_contact_id.ref">
          <t t-esc="employee.work_contact_id.ref[-4:]" />
        </t>
      </div>
    </xpath>
  </template>
</odoo>
