#. module: hr_personal_equipment_report_email
#: model:mail.template,body_html:hr_personal_equipment_report_email.mail_template_ppe_delivery
msgid ""
"\n"
"            <div>\n"
"                <p>\n"
"                    Dear <strong>\n"
"                        <a href=\"${object.get_base_url()}/web#id=${object.equipment_request_id.employee_id.id}&model=hr.employee&view_type=form\">\n"
"                            ${(object.equipment_request_id.employee_id.name.split(',')[1].strip() + ' ' + object.equipment_request_id.employee_id.name.split(',')[0].strip()) \n"
"                              if ',' in object.equipment_request_id.employee_id.name \n"
"                              else object.equipment_request_id.employee_id.name}\n"
"                        </a>\n"
"                    </strong>,\n"
"                </p>\n"
"\n"
"                <p>\n"
"                    Please find attached the list of Personal Protective Equipment (PPE) items delivered to you,\n"
"                    signed on <strong>${format_date(object.custom_date_done or object.date_done)}</strong>.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

