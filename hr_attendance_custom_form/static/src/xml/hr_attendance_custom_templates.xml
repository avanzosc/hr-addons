<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <t t-extend="HrAttendanceKioskConfirm">
        <t t-jquery=".o_hr_attendance_pin_pad" t-operation="replace">
            <div class="row">
                <div class="col-md-8 offset-md-2 o_hr_attendance_pin_pad">
                    <div class="row g-0">
                        <div class="col-12 mb8 mt8">
                            <input
                                class="o_hr_attendance_PINbox border-0 bg-white fs-1 text-center"
                                type="password"
                                disabled="true"
                            />
                        </div>
                    </div>
                        <div class="row g-0">
                            <t t-foreach="['1', '2', '3', '4', '5', '6', '7', '8', '9', ['C', 'btn-warning'], '0', ['ok', 'btn-primary']]" t-as="btn_name">
                                <div class="col-4 p-1">
                                    <a href="#" t-attf-class="o_hr_attendance_PINbox_button btn {{btn_name[1]? btn_name[1] : 'btn-secondary border'}} btn-block btn-lg {{ 'o_hr_attendance_pin_pad_button_' + btn_name[0] }} d-flex align-items-center justify-content-center">
                                        <t t-esc="btn_name[0]"/>
                                    </a>
                                </div>
                            </t>
                        </div>
                </div>
            </div>
        </t>
    </t>

    <!-- <t t-extend="HrAttendanceCardLayout">
        <t t-jquery=".o_hr_attendance_kiosk_mode_container" t-operation="replace" />
    </t> -->
</templates>