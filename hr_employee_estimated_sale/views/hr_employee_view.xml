<odoo>
  <record id="view_hr_employee_form_estimated_sale" model="ir.ui.view">
    <field name="name">hr.employee.form.estimated.sale</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='hr_settings']//group[@name='application_group']" position="inside">
        <field name="estimated_sale_price" string="Precio estimado venta"/>
      </xpath>
    </field>
  </record>
</odoo>
