<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_kanban_view_employee_self" model="ir.ui.view">
        <field name="model">hr.employee</field>
        <field
      name="inherit_id"
      ref="hr_employee_sees_himself.hr_kanban_view_employee_self"
    />
        <field name="arch" type="xml">
            <div class="oe_kanban_details" position="inside">
                <button
          name="%(hr_timesheet_sheet.act_hr_employee_2_hr_timesheet)d"
          type="action"
          context="{'search_default_employee_id': active_id}"
          class="btn btn-outline-primary w-100 mt-2 p-2 text-start"
        >
                    <i class="fa fa-clock-o me-2" />
                    <span class="h5 mb-0">
                      <field name="timesheet_sheet_count" />
                    </span>
                    <span class="fw-bold text-primary fs-5"> Timesheets</span>
                </button>
            </div>
        </field>
    </record>
</odoo>
