<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_today_in_hr_attendance_leave_report" model="ir.cron">
        <field name="name">Activate today's day in Attendances And Absences</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!--<field name="repeat_missed" eval="False" /> -->
        <field name="model_id" ref="hr_contract.model_hr_contract" />
        <field name="code">model.ir_cron_active_today_day_in_calendar()</field>
        <field name="state">code</field>
        <field
      name="nextcall"
      eval="(DateTime.now().replace(hour=1, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"
    />
    </record>
</odoo>
