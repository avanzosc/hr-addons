<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_kanban_view_employee_self" model="ir.ui.view">
        <field name="model">hr.employee</field>
        <field
      name="inherit_id"
      ref="hr_employee_sees_himself.hr_kanban_view_employee_self"
    />
        <field name="arch" type="xml">
            <div class="oe_kanban_details" position="inside">
                <button
          name="document_view"
          type="object"
          class="btn btn-outline-primary w-100 mt-2 p-2 text-start"
        >
                    <i class="fa fa-file-text me-2" />
                    <span class="h5 mb-0">
                      <field name="document_count" />
                    </span>
                    <span class="fw-bold text-primary fs-5"> Documents</span>
                </button>
            </div>
        </field>
    </record>
</odoo>
