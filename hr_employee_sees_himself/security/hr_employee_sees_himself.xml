<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="group_hr_employee_self" model="res.groups">
    <field name="name">Employee sees only himself</field>
    <field name="category_id" ref="base.module_category_hidden" />
    <field name="implied_ids" eval="[]" />
  </record>

  <record id="group_hr_employee_public" model="res.groups">
    <field name="name">Employee public group</field>
    <field name="category_id" ref="base.module_category_hidden" />
    <field name="implied_ids" eval="[]" />
  </record>

  <record id="rule_hr_employee_self" model="ir.rule">
    <field name="name">Employee sees only himself</field>
    <field name="model_id" ref="hr.model_hr_employee" />
    <field name="domain_force">[('user_id', '=', user.id)]</field>
    <field
      name="groups"
      eval="[(4, ref('hr_employee_sees_himself.group_hr_employee_self'))]"
    />
  </record>

  <record id="group_show_base_menu" model="res.groups">
    <field name="name">Show Base Menu</field>
    <field name="category_id" ref="base.module_category_hidden" />
  </record>

  <record id="mail.menu_root_discuss" model="ir.ui.menu">
    <field
      name="groups_id"
      eval="[(6, 0, [ref('hr_employee_sees_himself.group_show_base_menu')])]"
    />
  </record>

  <record id="calendar.mail_menu_calendar" model="ir.ui.menu">
    <field
      name="groups_id"
      eval="[(6, 0, [ref('hr_employee_sees_himself.group_show_base_menu')])]"
    />
  </record>

  <record id="contacts.menu_contacts" model="ir.ui.menu">
    <field
      name="groups_id"
      eval="[(6, 0, [ref('hr_employee_sees_himself.group_show_base_menu')])]"
    />
  </record>

  <record id="website.menu_website_configuration" model="ir.ui.menu">
    <field
      name="groups_id"
      eval="[(6, 0, [ref('hr_employee_sees_himself.group_show_base_menu')])]"
    />
  </record>

  <record id="utm.menu_link_tracker_root" model="ir.ui.menu">
    <field
      name="groups_id"
      eval="[(6, 0, [ref('hr_employee_sees_himself.group_show_base_menu')])]"
    />
  </record>

  <record id="hr_holidays.menu_hr_holidays_root" model="ir.ui.menu">
    <field
      name="groups_id"
      eval="[(6, 0, [ref('hr_employee_sees_himself.group_show_base_menu')])]"
    />
  </record>

  <record id="hr_expense.menu_hr_expense_root" model="ir.ui.menu">
    <field
      name="groups_id"
      eval="[(6, 0, [ref('hr_employee_sees_himself.group_show_base_menu')])]"
    />
  </record>

  <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
    <field
      name="groups_id"
      eval="[(6, 0, [ref('hr_employee_sees_himself.group_show_base_menu')])]"
    />
  </record>
</odoo>
