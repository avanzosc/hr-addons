<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="group_hr_employee_self" model="res.groups">
        <field name="name">Employee sees only himself</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field name="implied_ids" eval="[]" />
    </record>

    <record id="rule_hr_employee_self" model="ir.rule">
        <field name="name">Employee sees only himself</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field
      name="groups"
      eval="[(4, ref('hr_employee_sees_himself.group_hr_employee_self'))]"
    />
    </record>

</odoo>
