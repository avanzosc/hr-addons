<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_kanban_view_employee_self" model="ir.ui.view">
        <field name="model">hr.employee</field>
        <field
      name="inherit_id"
      ref="hr_employee_sees_himself.hr_kanban_view_employee_self"
    />
        <field name="arch" type="xml">
            <div class="oe_kanban_details" position="inside">
                <field name="show_leaves" invisible="1" />
                <button
          name="%(hr_holidays.hr_leave_action_my)d"
          type="action"
          context="{'search_default_group_type':1}"
          groups="base.group_user"
          attrs="{'invisible': [('show_leaves','=', False)]}"
          class="btn btn-outline-primary w-100 mt-2 p-2 text-start"
        >
                    <i class="fa fa-calendar me-2" />
                    <span class="h5 mb-0">
                        <field name="allocation_used_display" /> /
                          <field name="allocation_display" />
                    </span>
                    <span class="h5 mb-0"> Days</span>
                    <span class="fw-bold text-primary fs-5"> Time Off</span>
                </button>
            </div>
        </field>
    </record>
</odoo>
