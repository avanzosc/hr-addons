<?xml version="1.0"?>
<odoo>
    <data>

        <!-- Menú de configuración de horarios -->
        <menuitem id="employee_work_schedule_menu" name="Work Schedules" parent="hr.menu_hr_configuration" action="action_employee_work_schedule"/>

        <!-- Vista tree y form para los horarios -->
        <record id="action_employee_work_schedule" model="ir.actions.act_window">
            <field name="name">Work Schedules</field>
            <field name="res_model">employee.work.schedule</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="view_employee_work_schedule_tree" model="ir.ui.view">
            <field name="name">employee.work.schedule.tree</field>
            <field name="model">employee.work.schedule</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="working_hours"/>
                    <field name="shift_type"/>
                </tree>
            </field>
        </record>

        <record id="view_employee_work_schedule_form" model="ir.ui.view">
            <field name="name">employee.work.schedule.form</field>
            <field name="model">employee.work.schedule</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name"/>
                        <field name="working_hours"/>
                        <field name="shift_type"/>
                    </group>
                </form>
            </field>
        </record>

    </data>
</odoo>
